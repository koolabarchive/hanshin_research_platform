{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "docs", "test", "data", "firebase-debug.log", "firestore-debug.log"]
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "app", "region": "asia-northeast3" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": { "firestore": { "host": "127.0.0.1", "port": 8085 }, "ui": { "enabled": false }, "singleProjectMode": true }
}
