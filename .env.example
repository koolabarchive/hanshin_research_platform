# 복사해서 .env 로 저장한 뒤 값을 채우세요. .env 파일은 저장소에 올리지 않습니다.

NODE_ENV=production
PORT=3000
# 리버스 프록시(nginx 등) 뒤에서 실행하면 1
TRUST_PROXY=1

# 이름·연락처·매칭 정보·설문 응답·서명을 암호화하는 키(32바이트, base64). 아래 명령으로 만드세요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 이 키를 잃어버리면 저장된 정보를 복구할 수 없습니다. DB 백업과 다른 곳에 따로 보관하세요.
DATA_KEY=

# 교내 구성원(학부생·대학원생·교직원)과 연구자 가입에 쓰는 학교 메일 도메인(쉼표로 여러 개)
CAMPUS_EMAIL_DOMAINS=hs.ac.kr

# 이메일 발송(SMTP). 비워 두면 메일이 실제로 나가지 않고 DB의 outbox 테이블에만 쌓입니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="한신 리서치풀 <no-reply@example.ac.kr>"

# 문자 발송. 학교가 계약한 문자 발송 업체의 HTTP API 주소·키·발신번호.
# 비워 두면 문자는 실제로 나가지 않고 outbox 에만 쌓입니다. 업체별 요청 형식은 src/mailer.js 의 sendSms 를 맞춰 주세요.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# DB·첨부 파일 위치(기본: data/pool.db, data/uploads)
# DB_FILE=/var/lib/research-pool/pool.db
# UPLOAD_DIR=/var/lib/research-pool/uploads

# 시연 모드: 로그인 화면에 시연 계정 버튼을 보여 줍니다. 운영(NODE_ENV=production)에서는 켜지지 않습니다.
# DEMO_MODE=1
